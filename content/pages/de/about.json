    },
    {
      "blockType": "grid",
      "gap": "6",
      "children": [
        {
          "blockType": "card",
          "children": [
            {
              "blockType": "badge",
              "text": "Barrierefrei",
              "variant": "subtle",
              "colorPalette": "green"
            }
          ],
          "title": "Standardmäßig barrierefrei",
          "description": "Tastatur- und Screenreader-Unterstützung ist in jeder Komponente enthalten",
          "body": "Wir testen mit echter Assistenztechnologie, nicht nur mit automatisierten Prüfungen, damit die Barrierefreiheit auch in der Produktion Bestand hat.",
          "imagePosition": "top",
          "variant": "elevated"
        },
        {
          "blockType": "card",
          "children": [
            {
              "blockType": "badge",
              "text": "Kombinierbar",
              "variant": "subtle",
              "colorPalette": "purple"
            }
