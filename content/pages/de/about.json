        {
          "blockType": "text",
          "size": "lg",
          "content": "Wir glauben, dass Teams schneller vorankommen, wenn Design und Entwicklung eine einzige Quelle der Wahrheit teilen. Artefact UI kombiniert eine echte Komponentenbibliothek mit einem Seiten-Builder, den auch Nicht-Entwickler sicher nutzen können – so bleibt das Design-System der einzige Ort, an dem Änderungen stattfinden, statt sich in einmaligen Überschreibungen zu verlieren."
        }
      ]
    },
    {
      "blockType": "stack",
      "direction": "vertical",
      "gap": "2",
      "children": [
        {
          "blockType": "badge",
          "variant": "subtle",
          "text": "Prinzipien",
          "colorPalette": "purple",
          "size": "sm"
        },
        {
          "blockType": "heading",
          "text": "Was wir schätzen",
          "size": "3xl",
          "as": "h2"
        }
