            {
              "blockType": "text",
              "size": "sm",
              "content": "Responsável pelo construtor de páginas do CMS e pelo registro de blocos que o alimenta.",
              "style": "color: var(--colors-fg-muted)"
            }
          ]
        },
        {
          "blockType": "stack",
          "direction": "vertical",
          "align": "center",
          "gap": "3",
          "padding": "2rem 1.5rem",
          "borderRadius": "1rem",
          "borderWidth": "1px",
