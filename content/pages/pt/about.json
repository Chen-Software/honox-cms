              "size": "2xl",
              "variant": "solid"
            },
            {
              "blockType": "heading",
              "text": "Priya Nair",
              "size": "lg",
              "as": "p"
            },
            {
              "blockType": "text",
              "size": "sm",
              "content": "Documentação e Acessibilidade",
              "style": "color: var(--colors-fg-muted); font-weight: 600"
