      "blockType": "grid",
      "gap": "6",
      "children": [
        {
          "blockType": "card",
          "children": [
            {
              "blockType": "badge",
              "text": "Accessible",
              "variant": "subtle",
              "colorPalette": "green"
            }
          ],
          "title": "Accessible by default",
          "description": "Keyboard and screen-reader support ship with every component",
          "body": "We test with real assistive technology, not just automated audits, so accessibility holds up in production.",
          "imagePosition": "top",
          "variant": "elevated"
        },
        {
          "blockType": "card",
          "children": [
            {
              "blockType": "badge",
              "text": "Composable",
              "variant": "subtle",
              "colorPalette": "purple"
            }
